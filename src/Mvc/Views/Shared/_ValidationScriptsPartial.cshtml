<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
<script>
    function normalizeLocalizedNumber(value) {
        if (typeof value !== "string") {
            return value;
        }

        const trimmedValue = value.trim();
        const lastCommaIndex = trimmedValue.lastIndexOf(",");
        const lastDotIndex = trimmedValue.lastIndexOf(".");

        if (lastCommaIndex >= 0 && lastDotIndex >= 0) {
            const decimalSeparator = lastCommaIndex > lastDotIndex ? "," : ".";
            const thousandsSeparator = decimalSeparator === "," ? "." : ",";

            return trimmedValue
                .split(thousandsSeparator).join("")
                .replace(decimalSeparator, ".");
        }

        if (lastCommaIndex >= 0 || lastDotIndex >= 0) {
            const separatorIndex = Math.max(lastCommaIndex, lastDotIndex);
            const fractionalDigits = trimmedValue.length - separatorIndex - 1;

            if (fractionalDigits > 0 && fractionalDigits <= 2) {
                return trimmedValue.replace(",", ".");
            }
        }

        return trimmedValue;
    }

    $.validator.methods.number = function (value, element) {
        if (this.optional(element)) {
            return true;
        }

        return /^-?(?:\d+|\d{1,3}(?:[.,]\d{3})+)(?:[.,]\d+)?$/.test(value);
    };

    $.validator.methods.range = function (value, element, param) {
        if (this.optional(element)) {
            return true;
        }

        const numericValue = Number(normalizeLocalizedNumber(value));

        return Number.isFinite(numericValue) && numericValue >= param[0] && numericValue <= param[1];
    };
</script>
