@model Mvc.Areas.Portal.ViewModels.DashboardViewModel

@{
	ViewData["Title"] = "Mi portal";

	string memberInitial = string.IsNullOrWhiteSpace(Model.MemberFullName)
		? "?"
		: Model.MemberFullName.Trim()[0].ToString().ToUpperInvariant();

	string statusText = Model.Status switch
	{
		Contracts.Enums.MemberStatus.Active => "Activo",
		Contracts.Enums.MemberStatus.Debtor => "Deudor",
		Contracts.Enums.MemberStatus.Inactive => "Inactivo",
		_ => "Sin información"
	};

	string badgeClass = Model.Status switch
	{
		Contracts.Enums.MemberStatus.Active => "bg-success",
		Contracts.Enums.MemberStatus.Debtor => "bg-warning text-dark",
		Contracts.Enums.MemberStatus.Inactive => "bg-secondary",
		_ => "bg-light text-dark"
	};
}

<div class="portal-dashboard py-3 py-md-4">
	<article class="membership-card card shadow-sm overflow-hidden">
		<div class="membership-card__identity card-body p-4 p-lg-5">
			<div class="d-flex flex-column flex-md-row align-items-center gap-4">
				<div class="profile-image-avatar">
					@if (string.IsNullOrWhiteSpace(Model.ProfileImageUrl))
					{
						<span aria-hidden="true">@memberInitial</span>
					}
					else
					{
						<img src="@Model.ProfileImageUrl" alt="Imagen de perfil de @Model.MemberFullName" />
					}
				</div>

				<div class="flex-grow-1 text-center text-md-start">
					<div class="membership-card__organization small text-uppercase mb-1">
						@Model.OrganizationName
					</div>
					<h1 class="h4 mb-0">@Model.MemberFullName</h1>
				</div>

				<div class="membership-card__status d-flex justify-content-center">
					<span class="badge rounded-pill px-3 py-2 @badgeClass">@statusText</span>
				</div>
			</div>
		</div>

		<div class="card-body p-0">
			<div class="row g-0">
				<section class="membership-card__section col-12 col-md-6 p-4" aria-labelledby="membership-details-title">
					<h2 id="membership-details-title" class="membership-card__section-title h6 mb-4">
						Membresía
					</h2>

					<dl class="membership-card__details mb-0">
						<div>
							<dt>Plan</dt>
							<dd>@Model.MembershipPlanName</dd>
						</div>

						<div>
							<dt>Miembro desde</dt>
							<dd>@Model.AdmissionDate.ToString("dd/MM/yyyy")</dd>
						</div>
					</dl>
				</section>

				<section class="membership-card__section col-12 col-md-6 p-4" aria-labelledby="last-payment-title">
					<h2 id="last-payment-title" class="membership-card__section-title h6 mb-4">
						Último pago
					</h2>

					@if (Model.LastPaymentAmount is null)
					{
						<p class="text-muted mb-0">No hay pagos registrados.</p>
					}
					else
					{
						<dl class="membership-card__details mb-0">
							<div>
								<dt>Monto</dt>
								<dd class="membership-card__payment-amount">
									@Model.LastPaymentAmount.Value.ToString("C")
								</dd>
							</div>

							<div>
								<dt>Fecha</dt>
								<dd>
									@(Model.LastPaymentDate?.ToString("dd/MM/yyyy") ?? "No disponible")
								</dd>
							</div>
						</dl>
					}
				</section>
			</div>
		</div>
	</article>
</div>
